<!-- MiWire library. The selected cover supplies the accent for the short rule above the hero. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_black"
    android:clipChildren="false"
    tools:context=".AppView"
    tools:ignore="Overdraw" >

    <!-- The games fill this; the header sits over their top and scrolls away with them
         (CollapsingHeader), and the slim bar takes over once Play has scrolled off -->
    <FrameLayout
        android:id="@+id/appContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/cg_content_padding"
        android:paddingEnd="@dimen/cg_content_padding"
        android:paddingTop="@dimen/cg_content_padding_top">

        <FrameLayout
            android:id="@+id/appFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/appHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- As tall as the PC name. The wordmark shrinks to stay clear of a long name, and its
                 text box can be taller than the row: it's centred on it, and only blank space
                 above and below the letters spills over, so the game stays put (WordmarkRow) -->
            <com.limelight.ui.WordmarkRow
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <TextView
                    android:id="@+id/appListText"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/cg_chip"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:preferKeepClear="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Centred, or at the end on narrow screens (cover_glow_dimens.xml) -->
                <com.limelight.ui.Wordmark
                    android:id="@+id/cgWordmark"
                    style="@style/CgWordmarkPlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:text="@string/cg_wordmark"
                    android:textColor="@color/mw_amber"
                    android:textSize="@dimen/cg_wordmark_size" />
            </com.limelight.ui.WordmarkRow>

            <View
                android:id="@+id/coverGlow"
                android:layout_width="52dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/mw_amber"
                android:importantForAccessibility="no" />

            <include layout="@layout/mw_library_hero" />

            <TextView
                android:id="@+id/coverRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cg_cover_row_margin_top"
                android:layout_marginBottom="4dp"
                android:textColor="#FFE2E8F0"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miniBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:alpha="0"
            android:background="@drawable/cg_mini_bar"
            android:clickable="true"
            android:contentDescription="@string/cg_back_to_top"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="6dp"
            android:visibility="invisible">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/miniPlay"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/cg_pill_white"
                android:drawableStart="@drawable/cg_ic_play"
                android:drawablePadding="8dp"
                android:focusable="false"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:stateListAnimator="@null"
                android:text="@string/cg_play"
                android:textAllCaps="false"
                android:textColor="#FF0B0F14"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
