<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <ImageButton
        android:id="@+id/settingsButton"
        style="@style/MiWireAction"
        android:src="@drawable/ic_settings"
        android:contentDescription="@string/cg_settings"
        android:nextFocusForward="@+id/overridesToggleButton" />
    <ImageButton
        android:id="@+id/overridesToggleButton"
        style="@style/MiWireAction"
        android:src="@drawable/ic_overrides_enabled"
        android:contentDescription="@string/cg_a11y_overrides"
        android:nextFocusForward="@+id/autoResumeToggleButton" />
    <ImageButton
        android:id="@+id/autoResumeToggleButton"
        style="@style/MiWireAction"
        android:src="@drawable/ic_auto_resume_enabled"
        android:contentDescription="@string/cg_a11y_auto_resume"
        android:nextFocusForward="@+id/helpButton" />
    <ImageButton
        android:id="@+id/helpButton"
        style="@style/MiWireAction"
        android:src="@drawable/ic_help"
        android:contentDescription="@string/help"
        android:nextFocusForward="@+id/manuallyAddPc" />
    <ImageButton
        android:id="@+id/manuallyAddPc"
        style="@style/MiWireAction"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/title_add_pc" />
</LinearLayout>
