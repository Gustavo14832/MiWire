<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/stream_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <!-- Wide screens only, on the main settings page (CoverGlowSettings.attachFeel):
         the Predicted impact panel, with a small credit line under it. The whole column
         starts hidden, so on narrow screens (a foldable's cover screen, phones in portrait)
         it can't take the width the settings list needs. -->
    <ScrollView
        android:id="@+id/feelColumn"
        android:layout_width="@dimen/mw_feel_width"
        android:layout_height="match_parent"
        android:layout_marginStart="28dp"
        android:layout_marginTop="24dp"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/feelPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/cg_feel_panel"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/feel_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/feel_fastest"
                        android:textColor="#FFCBD5E1"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/feel_smoothest"
                        android:textColor="#FFCBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/feelTrack"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/cg_feel_track" />

                    <View
                        android:id="@+id/feelKnob"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/cg_feel_knob" />
                </FrameLayout>

                <!-- Which settings move the marker, and which way (filled in by CoverGlowSettings) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/feel_moving_it"
                    android:textColor="#FFCBD5E1"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/feelFactors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/feelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#1AFFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/feel_delay"
                        android:textColor="#FFCBD5E1"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/feelDelay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/feel_battery"
                        android:textColor="#FFCBD5E1"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/feelBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Where the last setting you tapped came from, if another Moonlight version -->
            <TextView
                android:id="@+id/settingCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#8CCBD5E1"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
