<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FF963E">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <corners android:radius="8dp" />
                    <solid android:color="#463022" />
                    <stroke android:width="3dp" android:color="@color/mw_amber" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="8dp" />
                    <solid android:color="@color/mw_surface" />
                    <stroke android:width="1dp" android:color="@color/mw_edge" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
